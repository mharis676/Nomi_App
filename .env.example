# Local storage requires no login or credentials. Server mode is optional.
VITE_DATA_MODE=local
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server only. Never use a VITE_ prefix for database credentials.
DATABASE_URL=postgresql://app_runtime:password@host:5432/postgres?sslmode=verify-full
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
APP_ORIGIN=http://localhost:3000
PORT=3000
# Set only when running behind that exact number of trusted proxy hops.
# TRUST_PROXY_HOPS=1
